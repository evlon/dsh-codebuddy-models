{
  "name": "dsh-codebuddy-models",
  "version": "0.1.1",
  "description": "CodeBuddy/WorkBuddy models bundle for DeepSeek Harness (dsh): reads the local desktop login and serves the CodeBuddy subscription as a native provider route in the model picker",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./credentials": {
      "types": "./lib/credentials.d.ts",
      "default": "./lib/credentials.js"
    },
    "./adapter": {
      "types": "./lib/adapter.d.ts",
      "default": "./lib/adapter.js"
    },
    "./sse": {
      "types": "./lib/sse.d.ts",
      "default": "./lib/sse.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evlon/dsh-codebuddy-models.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "codebuddy",
    "workbuddy",
    "cordis",
    "llm",
    "plugin",
    "bundle"
  ],
  "author": "evlon",
  "bugs": {
    "url": "https://github.com/evlon/dsh-codebuddy-models/issues"
  },
  "homepage": "https://github.com/evlon/dsh-codebuddy-models#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "eventsource-parser": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
